{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": { "service": "backend" } },
    { "source": "/events/:path*", "destination": { "service": "backend" } },
    { "source": "/venues/:path*", "destination": { "service": "backend" } },
    { "source": "/coordinator/:path*", "destination": { "service": "backend" } },
    { "source": "/lead/:path*", "destination": { "service": "backend" } },
    { "source": "/notifications/:path*", "destination": { "service": "backend" } },
    { "source": "/equipment-requests/:path*", "destination": { "service": "backend" } },
    { "source": "/equipment/:path*", "destination": { "service": "backend" } },
    { "source": "/safety/:path*", "destination": { "service": "backend" } },
    { "source": "/registrations/:path*", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
